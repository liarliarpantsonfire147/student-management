# Supabase Credentials
SUPABASE_URL=https://your-supabase-project-url.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Newer Supabase projects may provide this instead of the legacy service-role key.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Optional one-time account bootstrap values
INITIAL_ADMIN_EMAIL=admin@school.edu
INITIAL_ADMIN_PASSWORD=ChangeMe_Admin_2025!
INITIAL_TEACHER_EMAIL=teacher@school.edu
INITIAL_TEACHER_PASSWORD=ChangeMe_Teacher_2025!

# Frontend (Vite exposes only VITE_* variables to the browser)
VITE_SUPABASE_URL=https://your-supabase-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Leave blank on Vercel: the app calls its own /api/users serverless function.
# For local split-server development only: VITE_API_URL=http://localhost:5000
